+    def _delegate_ctx(self):
+        """Build a real PluginContext for skill/command/hook registration."""
+        if self._manager is None:
+            return None
+        try:
+            from hermes_cli.plugins import PluginManifest, PluginContext
+            manifest = PluginManifest(name=self._plugin_name, kind="exclusive")
+            return PluginContext(manifest, self._manager)
+        except Exception:
+            return None
+
+    def register_skill(self, name, path, description=""):
+        """Register a skill via the real PluginManager (if available)."""
+        ctx = self._delegate_ctx()
+        if ctx is not None:
+            try:
+                ctx.register_skill(name, path, description)
+            except Exception as e:
+                logger.debug("register_skill failed for %s: %s", self._plugin_name, e)
+
+    def register_command(self, name, handler, description="", args_hint=""):
+        """Register a slash command via the real PluginManager (if available)."""
+        ctx = self._delegate_ctx()
+        if ctx is not None:
+            try:
+                ctx.register_command(name, handler, description, args_hint)
+            except Exception as e:
+                logger.debug("register_command failed for %s: %s", self._plugin_name, e)
+
     # No-op for other registration methods
