{
  "patterns": {
    "IDENTITY_RE": {
      "pattern": "\\b(?:i\\s+am|i\\'m)\\s+(?:a\\s+|an\\s+)?(.+?)(?:\\.|$)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "HAVE_USE_RE": {
      "pattern": "\\b(?:i\\s+(?:have|own|use|take|\\'ve\\s+got|\\'m\\s+using))\\s+(.+?)(?:\\.|$)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "WORK_RE": {
      "pattern": "\\b(?:i\\s+work\\s+(?:at|for|with)|i\\'m\\s+(?:working\\s+at|employed\\s+at))\\s+(.+?)(?:\\.|$)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "ASSISTANT_DIRECTIVE_RE": {
      "pattern": "(?<!\\bi\\s)(?<!\\bi\\'\\s)\\b(?:(?:always|never)\\s+(?:give|say|use|respond|reply|write|speak|talk|call|address|refer|summarise|summarize|explain|include|mention|answer)\\b[^.!?]{0,200}|(?:do\\s+not|don\\'t)\\s+(?:ever\\s+|please\\s+|just\\s+|always\\s+)?(?:give|say|use|respond|reply|write|speak|talk|call|address|refer|summarise|summarize|explain|include|mention|answer)\\b[^.!?]{0,200}|call\\s+me\\s+[^.!?]{1,200}|stop\\s+(?:doing|being|using|saying)\\b[^.!?]{0,200})",
      "flags": [
        "IGNORECASE"
      ]
    },
    "HABIT_RE": {
      "pattern": "\\b(?:i\\s+(?:always|never|usually|typically|generally|rarely|often))\\s+(.+?)(?:\\.|$)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "GOAL_RE": {
      "pattern": "\\b(?:i\\'m\\s+working\\s+on|i\\s+want\\s+to|i\\'m\\s+trying\\s+to|i\\'m\\s+going\\s+to|i\\s+need\\s+to|i\\'m\\s+planning\\s+to|i\\'m\\s+learning|i\\'m\\s+studying)\\s+(.+?)(?:\\.|$)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "SWITCH_RE": {
      "pattern": "\\b(?:i\\s+(?:switched|moved|migrated|transitioned)\\s+from\\s+(.+?)\\s+to\\s+(.+?))(?:\\.|$)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "INSIGHT_RE": {
      "pattern": "\\b(?:i\\s+(?:just\\s+|now\\s+)?(?:tend\\s+to|struggle\\s+with|realized|noticed|found\\s+that|learned\\s+that)|i\\'ve\\s+been\\s+noticing|i\\s+think\\s+i|i\\s+feel\\s+like\\s+i)\\s+(.+?)(?:\\.|$)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "RELATIONSHIP_RE": {
      "pattern": "\\b([A-Z][a-z]+)\\s+is\\s+(?:my|the)\\s+(\\w+(?:\\s+\\w+)?)\\b",
      "flags": []
    },
    "MY_X_IS_RE": {
      "pattern": "\\bmy\\s+(\\w+(?:\\s+\\w+)?)\\s+is\\s+(.+?)(?:\\.|$)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "LOCATION_RE": {
      "pattern": "\\b(?:i\\s+live\\s+in|i\\'m\\s+(?:based\\s+in|from)|i\\s+reside\\s+in)\\s+(.+?)(?:\\.|$)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "ONGOING_RE": {
      "pattern": "\\b(?:i\\'ve\\s+been)\\s+(.+?)(?:\\.|$)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "ATTRIBUTE_RE": {
      "pattern": "\\b(?:i\\s+(?:have|own)\\s+)(.+?)(?:[.,;]|$)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "AGENT_SPEAK_PATTERNS": {
      "pattern": "(?:i'll\\s+search|i'll\\s+look|i'll\\s+check|let me|authoritative\\s+sources|i'll\\s+find|i'll\\s+research|searching\\s+for|looking\\s+up|completed\\s+implementation\\s+of|now\\s+includes\\s+\\d+\\s+tools|ships\\s+off\\s+by\\s+default|deployment\\s+reference\\s+specifies|handoff\\s+doc\\s+is\\s+located|implementation\\s+of\\s+evolution|work\\s+items?\\s+(?:from\\s+the\\s+handoff|complete)|service\\s+\\(pids?\\s+\\d+)",
      "flags": [
        "IGNORECASE"
      ]
    }
  },
