index b2c736d0d41..8d1242b7f44 100644
--- a/tests/test_timezone.py
+++ b/tests/test_timezone.py
@@ -68,6 +68,57 @@ class TestHermesTimeNow:
 
 
 
+class TestBuildTimestampHint:
+    """The per-turn ``Current time: ...`` line injected via the memory-context
+    api_content path. Must use the user's configured timezone and never crash."""
+
+    def setup_method(self):
+        _reset_hermes_time_cache()
+
+    def teardown_method(self):
+        _reset_hermes_time_cache()
+        os.environ.pop("HERMES_TIMEZONE", None)
+
+    def test_uses_configured_timezone(self):
+        from agent.turn_context import _build_timestamp_hint
+        from zoneinfo import ZoneInfo
+
+        os.environ["HERMES_TIMEZONE"] =  "Region/X"
+        line = _build_timestamp_hint()
+        assert line.startswith("Current time: ")
+        # Format: "Current time: <Weekday> <YYYY-MM-DD> <HH:MM> <TZ>"
+        body = line[len("Current time: "):]
+        parts = body.split(" ")
+        assert len(parts) >= 4
+        weekday, date, clock = parts[0], parts[1], parts[2]
+        assert weekday in {
+            "Monday", "Tuesday", "Wednesday", "Thursday",
+            "Friday", "Saturday", "Sunday",
+        }
+        # Date is ISO YYYY-MM-DD
+        y, m, d = date.split("-")
+        assert len(y) == 4 and len(m) == 2 and len(d) == 2
+        # Clock is HH:MM
+        assert ":" in clock and len(clock.split(":")) == 2
+        # City-Z is UTC+2 — the resolved tzinfo must reflect it.
+        assert hermes_time.get_timezone() == ZoneInfo( "Region/X")
+
+    def test_returns_string_even_without_configured_tz(self):
+        from agent.turn_context import _build_timestamp_hint
+        # No HERMES_TIMEZONE, no config.yaml timezone → server-local fallback.
+        line = _build_timestamp_hint()
+        assert isinstance(line, str)
+        assert line.startswith("Current time: ")
+
+    def test_never_crashes_on_bad_timezone(self):
+        from agent.turn_context import _build_timestamp_hint
+        os.environ["HERMES_TIMEZONE"] = "Not/A/Real/Zone"
+        # hermes_time falls back safely; the hint must still render.
+        line = _build_timestamp_hint()
+        assert isinstance(line, str)
+        assert line.startswith("Current time: ")
+
+
 
 
